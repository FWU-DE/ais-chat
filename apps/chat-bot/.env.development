PORT=3000

# Authentication (local keycloak)
AUTH_SECRET="INSECURE_STRING_FOR_LOCAL_DEVELOPMENT_ONLY"
VIDIS_CLIENT_ID=ais-chat-dev-client
VIDIS_CLIENT_SECRET=ClientSecret
VIDIS_ISSUER_URI=http://localhost:8080/realms/ais-chat-local

# Persistence
DATABASE_URL=postgresql://admin:test1234@127.0.0.1:5432/app_db
API_DATABASE_URL=postgresql://admin:test1234@127.0.0.1:5432/api_db

# ais-chat-api
API_URL=http://localhost:3002

# Dummy local-only secrets, identical across apps
API_KEY=ApiKeyForAISChatApiAdminApi
ENCRYPTION_KEY=EncryptionKeyForEncryptedApiKeysToAISChatApi

# Valkey and RabbitMQ (local docker compose)
VALKEY_URL=redis://localhost:6379/0
RABBITMQ_URI=amqp://user:password@localhost:5672

# Crawl4AI (local docker compose)
CRAWL4AI_API_TOKEN=ais-chat-crawl4ai-token

# Bifrost gateway inference API
BIFROST_BASE_URL=http://localhost:8089/openai/v1
BIFROST_API_KEY=sk-bf-example-key

# S3 Object Storage (local RustFS)
OTC_ACCESS_KEY_ID=rustfsadmin
OTC_SECRET_ACCESS_KEY=RustFS-Admin-123456
OTC_S3_HOSTNAME=http://localhost:9000
OTC_S3_REGION=eu-de
OTC_BUCKET_NAME=ais-chat

# RustFS is internal-only, so send image attachments to the LLM as base64
IMAGE_ATTACHMENT_MODE=base64

# Local keycloak is served over plain HTTP
VIDIS_ALLOW_INSECURE_DISCOVERY=true
