{
  "name": "ais-chat-app",
  "version": "0.0.1",
  "description": "Main web application for AIS.chat",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:envless": "next build --experimental-build-mode compile",
    "check-types": "next typegen && tsc --noEmit",
    "clean": "find . -type d \\( -name node_modules -o -name dist -o -name .next \\) -not -path \"./.vercel/*\" -prune -exec rm -rf {} \\;",
    "dev": "next dev -p 3000 --turbo",
    "e2e": "NODE_OPTIONS=--experimental-require-module dotenvx run -f .env.local -- playwright test",
    "e2e:api": "dotenvx run -f .env.local -- playwright test tests/api/",
    "e2e:api:ui": "dotenvx run -f .env.local -- playwright test tests/api/ --ui",
    "e2e:headed": "dotenvx run -f .env.local -- playwright test --headed",
    "e2e:smoke": "NODE_OPTIONS=--experimental-require-module dotenvx run -f .env.local -- playwright test --grep @smoke --project chromium --project \"api test\"",
    "e2e:ui": "DEBUG=pw:api,pw:webserver dotenvx run -f .env.local -- playwright test --ui",
    "k6:build": "node e2e/load_test/esbuild.k6.config.mjs",
    "prek6:run": "pnpm k6:build",
    "k6:run": "dotenvx run -f .env.k6 -- k6 run",
    "prek6:run:cloud": "pnpm k6:build",
    "k6:run:cloud": "k6 cloud run -e LOADTEST_USERNAME=$LOADTEST_USERNAME -e LOADTEST_PASSWORD=$LOADTEST_PASSWORD -e LOADTEST_IDP_HINT=$LOADTEST_IDP_HINT -e LOADTEST_BASE_URL=$LOADTEST_BASE_URL -e LOADTEST_CHARACTER_ID=$LOADTEST_CHARACTER_ID -e LOADTEST_VUS=$LOADTEST_VUS -e API_KEY=$API_KEY",
    "lint": "eslint . --max-warnings 0",
    "smart-report:merge": "rm -rf smart-report/blobs && mkdir -p smart-report/blobs && cp ../*/blob-report/*.zip smart-report/blobs/ && pnpm exec playwright merge-reports --config=smart-report/merge.config.ts smart-report/blobs",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "types": "tsc"
  },
  "dependencies": {
    "@ais-chat/ai-core": "workspace:*",
    "@ais-chat/shared": "workspace:*",
    "@ais-chat/ui": "workspace:*",
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@hookform/resolvers": "5.9.2",
    "@langchain/textsplitters": "1.0.2",
    "@mozilla/readability": "0.6.0",
    "@opentelemetry/api": "1.10.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@sentry/nextjs": "11.9.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-virtual": "3.14.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "docx": "9.14.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "drizzle-zod": "0.8.3",
    "he": "2.0.0",
    "import-in-the-middle": "3.5.2",
    "isbinaryfile": "6.0.0",
    "jose": "6.2.13",
    "jsdom": "30.1.3",
    "jsxgraph": "1.14.1",
    "katex": "0.19.0",
    "linkup-sdk": "3.7.1",
    "markdown-it": "15.0.3",
    "nanoid": "6.0.2",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-axiom": "1.10.0",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "oauth4webapi": "3.8.8",
    "pg": "8.23.1",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-image-crop": "11.1.2",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.2",
    "react-textarea-autosize": "8.5.9",
    "rehype-katex": "7.0.1",
    "remark-docx": "0.3.29",
    "remark-gfm": "4.0.1",
    "remark-math-extended": "6.1.1",
    "remark-parse": "11.0.0",
    "require-in-the-middle": "8.0.1",
    "sharp": "0.35.5",
    "strip-json-comments": "5.0.3",
    "tailwind-merge": "3.7.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "viem": "2.57.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ais-chat/eslint-config": "workspace:*",
    "@ais-chat/typescript-config": "workspace:*",
    "@axe-core/playwright": "4.14.0",
    "@dotenvx/dotenvx": "2.38.2",
    "@playwright/test": "1.64.1",
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/hast": "3.0.5",
    "@types/he": "1.2.3",
    "@types/jsdom": "30.0.0",
    "@types/k6": "2.3.0",
    "@types/katex": "0.16.8",
    "@types/markdown-it": "14.2.0",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "k6": "0.0.0",
    "playwright-core": "1.64.1",
    "playwright-smart-reporter": "4.0.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-eslint": "17.1.2",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
