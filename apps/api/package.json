{
  "name": "ais-chat-api",
  "version": "0.0.0",
  "description": "OpenAI compatible API server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "clean": "find . -type d \\( -name node_modules -o -name dist -o -name .next \\) -not -path \"./.vercel/*\" -prune -exec rm -rf {} \\;",
    "dev": "NODE_ENV=development tsx watch src/index.ts | pino-pretty",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint . --max-warnings 0",
    "start": "NODE_ENV=production tsx src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest run --watch",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@ais-chat/ai-core": "workspace:*",
    "@ais-chat/api-database": "workspace:*",
    "@ais-chat/shared-core": "workspace:*",
    "@dotenvx/dotenvx": "2.38.2",
    "@fastify/cors": "11.4.1",
    "@fastify/multipart": "10.1.8",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@sentry/node": "11.11.0",
    "@sentry/profiling-node": "11.11.0",
    "@t3-oss/env-core": "0.13.11",
    "fastify": "5.12.8",
    "fastify-graceful-shutdown": "5.0.0",
    "openai": "7.53.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ais-chat/eslint-config": "workspace:*",
    "@ais-chat/typescript-config": "workspace:*",
    "@playwright/test": "1.65.0",
    "@sentry/esbuild-plugin": "11.11.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.8.1",
    "pino-pretty": "13.2.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
