PORT=3001

# Authentication
# Random key can be created with 'openssl rand -base64 32'
AUTH_SECRET="INSECURE_STRING_FOR_LOCAL_DEVELOPMENT_ONLY"
KEYCLOAK_CLIENT_ID=ais-chat-admin-dev-client
KEYCLOAK_CLIENT_SECRET=ClientSecret
KEYCLOAK_ISSUER=http://localhost:8080/realms/ais-chat-admin-local

# Bifrost gateway management API
BIFROST_ADMIN_URL=http://localhost:8089
BIFROST_ADMIN_USERNAME=admin
BIFROST_ADMIN_PASSWORD=admin

# S3 Object Storage (local RustFS)
OTC_ACCESS_KEY_ID=rustfsadmin
OTC_SECRET_ACCESS_KEY=RustFS-Admin-123456
OTC_S3_HOSTNAME=http://localhost:9000
OTC_S3_REGION=eu-de
OTC_BUCKET_NAME=ais-chat

CHAT_BOT_BASE_URL=http://localhost:3000

# Persistence
DATABASE_URL=postgresql://admin:test1234@127.0.0.1:5432/app_db
API_DATABASE_URL=postgresql://admin:test1234@127.0.0.1:5432/api_db

# ais-chat-api
API_URL=http://localhost:3002

# Dummy local-only secrets, identical across apps
API_KEY=ApiKeyForAISChatApiAdminApi
ENCRYPTION_KEY=EncryptionKeyForEncryptedApiKeysToAISChatApi
