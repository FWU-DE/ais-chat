{
  "name": "ais-chat-admin",
  "version": "0.1.0",
  "description": "Admin web application",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:envless": "next build --experimental-build-mode compile",
    "check-types": "next typegen && tsc --noEmit",
    "dev": "next dev -p 3001 --turbo",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "start": "next start",
    "test": "vitest run"
  },
  "dependencies": {
    "@ais-chat/api-database": "workspace:*",
    "@ais-chat/shared": "workspace:*",
    "@ais-chat/ui": "workspace:*",
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/s3-request-presigner": "3.1116.0",
    "@hookform/resolvers": "5.9.1",
    "@opentelemetry/api": "1.9.1",
    "@phosphor-icons/react": "2.1.10",
    "@sentry/nextjs": "10.70.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-table": "9.1.2",
    "lucide-react": "1.33.0",
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-csv": "2.2.2",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "require-in-the-middle": "8.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ais-chat/eslint-config": "workspace:*",
    "@ais-chat/typescript-config": "workspace:*",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-csv": "1.1.10",
    "@types/react-dom": "19.2.4",
    "@types/react-syntax-highlighter": "15.5.13",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-eslint": "17.1.2",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
