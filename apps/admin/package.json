{
  "name": "ais-chat-admin",
  "version": "0.1.0",
  "description": "Admin web application",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:envless": "next build --experimental-build-mode compile",
    "check-types": "next typegen && tsc --noEmit",
    "dev": "dotenvx run -f .env.local -f .env.development -- next dev --turbo",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "lint": "eslint . --max-warnings 0",
    "start": "next start",
    "test": "vitest run"
  },
  "dependencies": {
    "@ais-chat/api-database": "workspace:*",
    "@ais-chat/shared": "workspace:*",
    "@ais-chat/shared-core": "workspace:*",
    "@ais-chat/ui": "workspace:*",
    "@hookform/resolvers": "7.0.1",
    "@opentelemetry/api": "1.10.0",
    "@phosphor-icons/react": "2.1.10",
    "@sentry/nextjs": "11.10.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-table": "9.3.1",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-csv": "2.2.2",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ais-chat/eslint-config": "workspace:*",
    "@ais-chat/typescript-config": "workspace:*",
    "@dotenvx/dotenvx": "2.38.2",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-csv": "1.1.10",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "eslint": "10.8.1",
    "playwright-smart-reporter": "4.0.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-eslint": "17.1.2",
    "tailwindcss": "4.3.5",
    "tailwindcss-animate": "1.0.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
