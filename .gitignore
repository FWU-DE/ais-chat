# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules
**/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
**/coverage

# turbo
.turbo

# next.js
**/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
export
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.development

# vercel
.vercel

# typescript
dist/
*.tsbuildinfo
next-env.d.ts

certificates

playwright-report/
.playwright-auth/
.playwright-mcp/
test-results/
blob-report/
# smart-reporter output for the three e2e apps, except the committed merge config.
apps/*/smart-report/*
!apps/*/smart-report/merge.config.ts

# Sentry Config File
.env.sentry-build-plugin

apps/chat-bot/e2e/load_test/*.js
apps/chat-bot/e2e/load_test/success-results/
apps/chat-bot/e2e/load_test/error-results/
