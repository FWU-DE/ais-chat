{
  "name": "@ais-chat/api-database",
  "version": "0.0.0",
  "description": "API database schema",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bifrost-provider-sync": "./src/bifrost-provider-sync/index.ts",
    "./bifrost-provider-sync/error": "./src/bifrost-provider-sync/error.ts",
    "./llm-model": "./src/llm-model/index.ts",
    "./types": "./src/types.ts",
    "./utils": "./src/api-utils/index.ts"
  },
  "scripts": {
    "db:generate": "dotenvx run -f ../../apps/api/.env.local -f ../../apps/api/.env.development -- drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate --config=./drizzle.config.ts",
    "db:migrate:local": "dotenvx run -f ../../apps/api/.env.local -f ../../apps/api/.env.development -- drizzle-kit migrate --config=./drizzle.config.ts",
    "db:seed": "dotenvx run -f ../../apps/api/.env.local -f ../../apps/api/.env.development -- tsx src/seed.ts",
    "db:seed:from-stage": "dotenvx run -f ../../apps/api/.env.local -f ../../apps/api/.env.development -f ../../apps/admin/.env.development -- tsx src/seed-from-stage.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@ais-chat/shared-core": "workspace:*",
    "@t3-oss/env-core": "0.13.11",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "nanoid": "6.0.1",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ais-chat/eslint-config": "workspace:*",
    "@ais-chat/typescript-config": "workspace:*",
    "@dotenvx/dotenvx": "2.28.2",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "tsx": "4.23.14",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
