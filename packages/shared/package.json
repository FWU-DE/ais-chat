{
  "name": "@ais-chat/shared",
  "version": "0.0.1",
  "description": "Shared application services and database schema for the chat app",
  "main": "src/index.ts",
  "type": "module",
  "private": true,
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:drop": "dotenvx run -f ../../apps/chat-bot/.env.local -f ../../apps/chat-bot/.env.development -- drizzle-kit drop --config=./drizzle.config.ts",
    "db:generate": "dotenvx run -f ../../apps/chat-bot/.env.local -f ../../apps/chat-bot/.env.development -- drizzle-kit generate --config=./drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=./drizzle.config.ts",
    "db:migrate:local": "dotenvx run -f ../../apps/chat-bot/.env.local -f ../../apps/chat-bot/.env.development -- drizzle-kit migrate --config=./drizzle.config.ts",
    "db:seed": "dotenvx run -f ../../apps/chat-bot/.env.local -f ../../apps/chat-bot/.env.development -- tsx src/db/seed/index.ts",
    "db:seed:from-stage": "dotenvx run -f ../../apps/chat-bot/.env.local -f ../../apps/chat-bot/.env.development -- tsx src/db/seed/seed-from-stage.ts",
    "db:seed:local": "ENVIRONMENT=development dotenvx run -f ../../apps/chat-bot/.env.local -f ../../apps/chat-bot/.env.development -- tsx src/db/seed/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@ais-chat/ai-core": "workspace:*",
    "@ais-chat/shared-core": "workspace:*",
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@sentry/nextjs": "10.74.0",
    "@sentry/opentelemetry": "10.74.0",
    "@t3-oss/env-core": "0.13.11",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "ioredis": "6.0.0",
    "linkup-sdk": "3.7.0",
    "nanoid": "6.0.1",
    "next": "16.3.5",
    "pg": "8.23.0",
    "unstorage": "1.17.5",
    "uuid": "14.0.2",
    "viem": "2.56.5",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@ais-chat/eslint-config": "workspace:*",
    "@ais-chat/typescript-config": "workspace:*",
    "@dotenvx/dotenvx": "2.24.1",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "prettier-eslint": "17.1.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
