{
  "name": "@ais-chat/ai-core",
  "version": "0.0.1",
  "description": "AI and LLM integration layer for communicating with AI providers",
  "main": "src/index.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@ais-chat/api-database": "workspace:*",
    "@anthropic-ai/sdk": "0.128.0",
    "@anthropic-ai/vertex-sdk": "0.19.11",
    "@google/genai": "2.24.0",
    "@opentelemetry/api": "1.9.1",
    "@sentry/core": "11.1.0",
    "@sentry/server-utils": "11.1.0",
    "google-auth-library": "11.1.0",
    "js-tiktoken": "1.0.21",
    "openai": "7.23.0",
    "openaiv4": "npm:openai@4.104.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ais-chat/eslint-config": "workspace:*",
    "@ais-chat/typescript-config": "workspace:*",
    "@t3-oss/env-core": "0.13.11",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.8.1",
    "prettier": "3.9.9",
    "prettier-eslint": "17.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
